{
  "name": "oh-shi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "eval": "node scripts/run-evals.mjs evals/run.ts",
    "eval:live": "node scripts/run-evals.mjs evals/live-api.test.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "pilot:domains": "tsx scripts/build-startup-domain-pilot.ts",
    "pilot:measure-yield": "tsx scripts/measure-startup-domain-yield.ts",
    "verify:structured": "tsx scripts/verify-structured-career-source.ts",
    "verify:workable": "tsx scripts/verify-workable-source.ts",
    "verify:recruitee": "tsx scripts/verify-recruitee-source.ts",
    "verify:personio": "tsx scripts/verify-personio-source.ts",
    "verify:smartrecruiters": "tsx scripts/verify-smartrecruiters-source.ts",
    "audit:live-quality": "tsx scripts/audit-live-data-quality.ts",
    "quality": "pnpm run typecheck && pnpm run eval && pnpm run build",
    "quality:ci": "pnpm run lint && pnpm run typecheck && pnpm run eval && pnpm run build && pnpm run e2e",
    "test": "pnpm run eval",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern playwright-report --ignore-pattern test-results",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tldts": "7.4.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "5.20260814.1",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "miniflare": "4.20260730.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  },
  "type": "module"
}
